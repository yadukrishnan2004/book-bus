							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Kerala Express\",\n    \"number_plate\": \"KL-01-AB-1234\",\n    \"total_seats\": 45,\n    \"bus_type\": \"ac\",\n    \"description\": \"Comfortable AC bus for long distance travel\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/buses",
							"host": [
