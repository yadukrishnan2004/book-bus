						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const body = pm.response.json();",
									"    pm.collectionVariables.set('auth_token', body.data.token);",
									"    console.log('auth_token set:', body.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Passenger\",\n    \"email\": \"passenger@example.com\",\n    \"phone\": \"9876543210\",\n    \"password\": \"password123\"\n}",
							"options": {
